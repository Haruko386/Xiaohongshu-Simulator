<!DOCTYPE html>
<html lang="zh-CN">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>小红书 - 你的生活指南</title>
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" rel="stylesheet">
    <link href="/static/index.css" rel="stylesheet">
</head>
<body>

<aside class="sidebar">
    <div class="logo">小红书</div>
    <nav>
        <a href="/" class="nav-item active"><i class="fas fa-compass"></i> 发现</a>
        <a href="/publish" class="nav-item" onclick="checkLogin(event, '{{.LoggedInUserID}}')"><i class="fas fa-plus-square"></i> 发布</a>
        <a href="#" class="nav-item" onclick="openNotificationModal(event)">
            <i class="fas fa-bell"></i> 通知
            <span id="unread-badge" style="background: var(--primary-red); color: white; border-radius: 10px; padding: 0 6px; font-size: 12px; font-weight: bold; margin-left: 5px; display: none;">0</span>
        </a>
        <a href="/user/profile/{{.LoggedInUserID}}" class="nav-item" onclick="checkLogin(event, '{{.LoggedInUserID}}')"><i
                    class="fas fa-user"></i> 我</a>
    </nav>
    {{ if .NeedsLogin }}
    <div class="sidebar-login-card">
        <strong>登录后体验更多</strong>
        发现更懂你的内容，收藏、点赞并参与讨论。
        <button type="button" onclick="openLoginModal()">登录</button>
    </div>
    {{ end }}
    <div class="more-container">
        <div class="more-menu" id="more-menu">
            <div class="menu-item">关于小红书</div>
            <div class="menu-item">帮助与客服</div>
            {{ if not .NeedsLogin }}
            <div class="menu-divider"></div>
            <div class="menu-item" onclick="handleLogout()">退出登录</div>
            {{ end }}
        </div>
        <div class="more-btn" onclick="toggleMoreMenu(event)">
            <i class="fas fa-bars"></i> 更多
        </div>
    </div>
</aside>

<main class="main-content">
    <header class="header">
        <div class="search-bar">
            <i class="fas fa-search"></i>
            <input id="feed-search" type="search" placeholder="搜索笔记或用户" autocomplete="off" aria-label="搜索笔记或用户">
            <button id="search-clear" class="search-clear" type="button" onclick="clearFeedSearch()" aria-label="清空搜索"><i class="fas fa-circle-xmark"></i></button>
        </div>
    </header>

    <div class="categories" aria-label="内容分类">
        <div class="cat-item active">推荐</div>
        <div class="cat-item">穿搭</div>
        <div class="cat-item">美食</div>
        <div class="cat-item">彩妆</div>
        <div class="cat-item">影视</div>
        <div class="cat-item">职场</div>
        <div class="cat-item">情感</div>
        <div class="cat-item">家居</div>
        <div class="cat-item">游戏</div>
        <div class="cat-item">旅行</div>
        <div class="cat-item">健身</div>
    </div>

    <div id="waterfall-container" class="waterfall-container">
        {{ range .Posts }}
            <article class="card" data-title="{{ .Title }}" data-user="{{ .User.Username }}" tabindex="0" role="button" onclick="openPostDetail('{{ .ID }}')" onkeydown="if(event.key === 'Enter') openPostDetail('{{ .ID }}')">

                <img src="/asset/{{ .User.Username }}/Posts/{{ .ID }}/{{ .CoverImage }}" alt="{{ .Title }}"
                     class="card-img" loading="lazy">

                <div class="card-info">
                    <div class="card-title">{{ .Title }}</div>
                    <div class="card-meta">
                        <div class="card-author">
                            <img src="/asset/{{ .User.Username }}/{{ .User.Avatar }}" alt="" loading="lazy">
                            <span>{{ .User.Username }}</span>
                        </div>
                        <div class="likes">
                            <i class="{{ if .IsLiked }}fas fa-heart{{ else }}far fa-heart{{ end }}"
                               {{ if .IsLiked }}style="color: var(--primary-red);"{{ end }}></i>
                            <span>{{ .LikeCount }}</span>
                        </div>
                    </div>
                </div>
            </article>
        {{ end }}
    </div>
    <div id="search-empty" class="empty-feed" style="display:none;"><i class="far fa-face-meh"></i>没有找到相关笔记，换个关键词试试</div>
    {{ if not .Posts }}<div class="empty-feed"><i class="far fa-images"></i>暂时还没有笔记</div>{{ end }}
</main>

<div id="login-modal" class="modal-overlay" style="display: none;" onclick="closeOnBackdrop(event, 'login-modal')">
    <div class="modal-content" role="dialog" aria-modal="true" aria-label="登录或注册">
        <span class="close-btn" onclick="closeModal()"><i class="fas fa-times"></i></span>

        <div class="modal-left">
            <h3>登录后推荐更懂你的笔记</h3>
            <div class="qr-placeholder">
                <i class="fas fa-qrcode" style="font-size: 80px; color: #ccc;"></i>
            </div>
            <p>可用 <span style="color: var(--primary-red); font-weight: bold;">小红书</span> App 扫码</p>
        </div>

        <div class="modal-right">
            <div class="modal-tabs">
                <span class="modal-tab active" onclick="switchTab('login')">账号登录</span>
                <span class="modal-tab" onclick="switchTab('register')">新用户注册</span>
            </div>

            <div id="login-form">
                <div class="input-group">
                    <input type="text" id="login-username" placeholder="输入用户名">
                </div>
                <div class="input-group">
                    <input type="password" id="login-password" placeholder="输入密码">
                </div>
                <button class="submit-btn" onclick="handleLogin()">登录</button>
            </div>

            <div id="register-form" style="display: none;">
                <div class="input-group">
                    <input type="text" id="reg-username" placeholder="设置用户名">
                </div>
                <div class="input-group">
                    <input type="password" id="reg-password" placeholder="设置密码">
                </div>
                <button class="submit-btn" onclick="handleRegister()">注册</button>
            </div>

            <div id="msg-box" class="message"></div>
        </div>
    </div>
</div>

<div id="post-detail-modal" class="post-detail-overlay" style="display: none;" onclick="closeOnBackdrop(event, 'post-detail-modal')">
    <div class="post-detail-box" role="dialog" aria-modal="true" aria-label="笔记详情">
        <div class="post-detail-left">
            <div class="close-detail-btn" onclick="closePostDetail()"><i class="fas fa-times"></i></div>
            <img id="detail-image" src="" alt="笔记封面">
        </div>

        <div class="post-detail-right">
            <div class="detail-header">
                <div class="detail-author">
                    <img id="detail-avatar" src="" onerror="this.onerror=null; this.src='/static/avatar-placeholder.svg'">
                    <span id="detail-username">加载中...</span>
                </div>
                <button id="modal-btn-follow" class="btn-follow" onclick="toggleModalFollow()" style="display: none; transition: all 0.2s;">关注</button>
                <button id="modal-btn-edit" class="btn-follow" onclick="openEditPostModal()" style="display: none; transition: all 0.2s; background: #f5f5f5; color: #333; border: 1px solid #ddd; margin-right: 10px;">编辑</button>
                <button id="modal-btn-delete" class="btn-follow" onclick="deletePost()" style="display: none; transition: all 0.2s; background: #ffebeb; color: var(--primary-red); border: 1px solid var(--primary-red);">删除</button>
            </div>

            <div class="detail-scroll">
                <div id="detail-title" class="detail-title">加载中...</div>
                <div id="detail-text" class="detail-text">加载中...</div>
                <div id="detail-time" class="detail-time">发布时间</div>

                <hr style="border: 0; border-top: 1px solid #f0f0f0; margin: 20px 0;">

                <div id="comment-count-label" class="comment-count">共 0 条评论</div>
                <div id="detail-comments-list" style="padding-bottom: 20px;"></div>
            </div>

            <div class="detail-footer">
                <div class="comment-composer">
                    <input type="text" id="comment-input" class="comment-input" placeholder="说点什么..." maxlength="300">
                    <button type="button" class="comment-send" onclick="submitComment()">发送</button>
                </div>
                <div class="interaction-icons">
                    <div class="action-btn" id="btn-like" onclick="toggleLike()">
                        <i id="icon-like" class="far fa-heart"></i>
                        <span id="count-like">0</span>
                    </div>
                    <div class="action-btn" id="btn-collect" onclick="toggleCollect()">
                        <i id="icon-collect" class="far fa-star"></i>
                        <span id="count-collect">0</span>
                    </div>
                    <div class="action-btn" onclick="shareCurrentPost()" title="分享笔记">
                        <i class="fas fa-share"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<div id="notification-modal" class="modal-overlay" style="display: none;" onclick="closeOnBackdrop(event, 'notification-modal')">
    <div class="notification-panel" role="dialog" aria-modal="true" aria-label="通知">
        <button type="button" class="icon-close" onclick="closeNotificationModal()" aria-label="关闭"><i class="fas fa-times"></i></button>
        <div class="notification-header">通知</div>
        <div id="notification-list-container" class="notification-list">
            <div style="text-align:center; padding: 30px; color:#999;">加载中...</div>
        </div>
    </div>
</div>

<div id="edit-post-modal" class="modal-overlay" style="display: none; z-index: 1005;">
    <div class="edit-modal-content" style="width: 600px; padding: 30px; border-radius: 16px; background: #fff;">
        <span class="close-btn" onclick="closeEditPostModal()"><i class="fas fa-times"></i></span>
        <div class="edit-modal-header" style="margin-bottom: 20px; font-size: 20px; font-weight: bold;">编辑笔记</div>

        <label for="edit-post-cover" class="upload-area" style="display: block; border: 2px dashed #ddd; border-radius: 8px; padding: 10px; text-align: center; cursor: pointer; margin-bottom: 20px;">
            <img id="edit-post-cover-preview" src="" style="max-height: 200px; max-width: 100%; border-radius: 8px; object-fit: contain; margin: 0 auto; display: block;">
            <div style="margin-top: 10px; color: #999; font-size: 14px;"><i class="fas fa-image"></i> 点击更换封面 (可选)</div>
        </label>
        <input type="file" id="edit-post-cover" accept="image/*" style="display: none;" onchange="previewEditPostCover(event)">
        <div style="margin-bottom: 15px; display: flex; align-items: center; gap: 10px;">
            <label style="font-size: 15px; color: #333; font-weight: bold;">谁可以看：</label>
            <select id="edit-post-visible" style="padding: 8px 12px; border-radius: 8px; border: 1px solid #eee; outline: none; font-size: 14px; background: #fafafa;">
                <option value="true">公开可见</option>
                <option value="false">仅自己可见</option>
            </select>
        </div>
        <input type="text" id="edit-post-title" class="publish-input" placeholder="修改标题" style="width: 100%; padding: 12px; margin-bottom: 15px; border: 1px solid #eee; border-radius: 8px; font-size: 16px; outline: none; box-sizing: border-box;">
        <textarea id="edit-post-text" class="publish-textarea" placeholder="修改正文..." style="width: 100%; padding: 12px; height: 200px; margin-bottom: 20px; border: 1px solid #eee; border-radius: 8px; resize: vertical; font-size: 15px; outline: none; font-family: inherit; box-sizing: border-box;"></textarea>

        <button class="submit-btn" style="width: 100%; padding: 14px; background: var(--primary-red); color: white; border: none; border-radius: 24px; font-size: 16px; cursor: pointer; font-weight: bold;" onclick="submitEditPost()">保存修改</button>
    </div>
</div>

<nav class="mobile-nav" aria-label="移动端导航">
    <a href="/" class="active"><i class="fas fa-compass"></i><span>发现</span></a>
    <a href="/publish" onclick="checkLogin(event, '{{.LoggedInUserID}}')"><i class="fas fa-plus-square"></i><span>发布</span></a>
    <a href="#" onclick="openNotificationModal(event)"><i class="fas fa-bell"></i><span>通知</span></a>
    <a href="/user/profile/{{.LoggedInUserID}}" onclick="checkLogin(event, '{{.LoggedInUserID}}')"><i class="fas fa-user"></i><span>我</span></a>
</nav>
<div id="toast-container" class="toast-container" aria-live="polite"></div>

<script>
    let currentPostId = null
    let currentReplyParentId = 0;
    let currentReplyToName = "";
    let currentPostAuthorId = 0;
    let currentPostVisible = true;

    function showToast(message) {
        const container = document.getElementById('toast-container');
        if (!container) return;
        const toast = document.createElement('div');
        toast.className = 'toast';
        toast.textContent = message;
        container.appendChild(toast);
        window.setTimeout(() => toast.remove(), 2400);
    }

    function setBodyLocked(locked) {
        document.body.style.overflow = locked ? 'hidden' : '';
    }

    function openLoginModal() {
        document.getElementById('login-modal').style.display = 'flex';
        setBodyLocked(true);
        window.setTimeout(() => document.getElementById('login-username')?.focus(), 80);
    }

    function closeModal() {
        document.getElementById('login-modal').style.display = 'none';
        setBodyLocked(false);
    }

    function closeOnBackdrop(event, modalId) {
        if (event.target.id !== modalId) return;
        if (modalId === 'post-detail-modal') closePostDetail();
        else if (modalId === 'notification-modal') closeNotificationModal();
        else if (modalId === 'login-modal') closeModal();
    }

    function escapeHtml(value) {
        const node = document.createElement('div');
        node.textContent = value == null ? '' : String(value);
        return node.innerHTML;
    }

    function applyFeedFilter(value) {
        const keyword = value.trim().toLocaleLowerCase('zh-CN');
        let visibleCount = 0;
        document.querySelectorAll('#waterfall-container .card').forEach(card => {
            const haystack = `${card.dataset.title || ''} ${card.dataset.user || ''}`.toLocaleLowerCase('zh-CN');
            const visible = !keyword || haystack.includes(keyword);
            card.style.display = visible ? 'inline-block' : 'none';
            if (visible) visibleCount++;
        });
        const empty = document.getElementById('search-empty');
        if (empty) empty.style.display = keyword && visibleCount === 0 ? 'block' : 'none';
        const clear = document.getElementById('search-clear');
        if (clear) clear.style.display = keyword ? 'block' : 'none';
    }

    function clearFeedSearch() {
        const input = document.getElementById('feed-search');
        if (!input) return;
        input.value = '';
        applyFeedFilter('');
        input.focus();
    }

    async function shareCurrentPost() {
        if (!currentPostId) return;
        const url = new URL(window.location.href);
        url.searchParams.set('note', currentPostId);
        const shareData = {title: document.getElementById('detail-title').innerText, text: '分享一篇小红书笔记', url: url.toString()};
        try {
            if (navigator.share) await navigator.share(shareData);
            else {
                await navigator.clipboard.writeText(shareData.url);
                showToast('链接已复制');
            }
        } catch (error) {
            if (error?.name !== 'AbortError') showToast('分享失败，请稍后重试');
        }
    }

    // 切换登录/注册 Tab
    function switchTab(type) {
        document.querySelectorAll('.modal-tab').forEach(t => t.classList.remove('active'));
        if (type === 'login') {
            document.querySelectorAll('.modal-tab')[0].classList.add('active');
            document.getElementById('login-form').style.display = 'block';
            document.getElementById('register-form').style.display = 'none';
        } else {
            document.querySelectorAll('.modal-tab')[1].classList.add('active');
            document.getElementById('login-form').style.display = 'none';
            document.getElementById('register-form').style.display = 'block';
        }
        document.getElementById('msg-box').style.display = 'none';
    }

    function showMsg(msg) {
        const box = document.getElementById('msg-box');
        box.innerText = msg;
        box.style.display = 'block';
    }

    // 处理注册
    async function handleRegister() {
        const username = document.getElementById('reg-username').value;
        const password = document.getElementById('reg-password').value;
        if (!username || !password) return showMsg("用户名或密码不能为空");

        const res = await fetch('/api/auth/register', {
            method: 'POST',
            headers: {'Content-Type': 'application/json'},
            body: JSON.stringify({username, password})
        });
        const data = await res.json();
        if (res.ok) {
            alert("注册成功，请直接登录！");
            switchTab('login'); // 自动切回登录页面
        } else {
            showMsg(data.error || "注册失败");
        }
    }

    // 处理登录
    async function handleLogin() {
        const username = document.getElementById('login-username').value;
        const password = document.getElementById('login-password').value;
        if (!username || !password) return showMsg("用户名或密码不能为空");

        const res = await fetch('/api/auth/login', {
            method: 'POST',
            headers: {'Content-Type': 'application/json'},
            body: JSON.stringify({username, password})
        });
        const data = await res.json();
        if (res.ok) {
            // 登录成功，刷新当前页面，因为有了 Cookie，后端不会再传 NeedsLogin=true
            const url = new URL(window.location.href);
            url.searchParams.delete('login');
            window.location.href = url.pathname + url.search;
        } else {
            showMsg(data.error || "登录失败");
        }
    }

    function checkLogin(e, uid) {
        if (!uid) {
            e.preventDefault();
            openLoginModal();
        }
    }

    function toggleMoreMenu(e) {
        e.stopPropagation(); // 阻止点击事件冒泡，防止触发下面的全局关闭
        document.getElementById('more-menu').classList.toggle('show');
    }

    // 监听全局点击事件，点击空白处自动关闭菜单
    document.addEventListener('click', function (e) {
        const menu = document.getElementById('more-menu');
        if (menu && menu.classList.contains('show')) {
            menu.classList.remove('show');
        }
    });

    // 处理退出登录
    async function handleLogout() {
        try {
            const res = await fetch('/api/auth/logout', {method: 'POST'});
            if (res.ok) {
                // 登出成功后，强制跳转回首页，首页检测不到 Cookie 会自动弹出登录框
                window.location.href = "/";
            } else {
                alert("退出失败，请重试");
            }
        } catch (err) {
            alert("网络请求错误");
        }
    }

    async function openPostDetail(postId) {
        document.getElementById('post-detail-modal').style.display = 'flex';
        setBodyLocked(true);

        try {
            const res = await fetch(`/api/posts/${postId}`);
            if (res.ok) {
                const data = await res.json(); // 解析返回的JSON
                currentPostId = postId
                currentPostVisible = data.post.visible;
                const btnFollow = document.getElementById('modal-btn-follow');
                currentPostAuthorId = data.post.user_id; // 获取作者ID

                // 如果自己看自己的帖子，不显示关注按钮
                // 注意这里需要你把 loggedInUserID 传给前端，或者后端判断如果没登录就是 ""
                const myUserId = '{{ .LoggedInUserID }}';
                const btnDelete = document.getElementById('modal-btn-delete');
                const btnEdit = document.getElementById('modal-btn-edit');
                if (String(currentPostAuthorId) === myUserId) {
                    // 看自己的帖子：隐藏关注，显示删除
                    btnFollow.style.display = 'none';
                    btnDelete.style.display = 'block';
                    btnEdit.style.display = 'block';
                } else {
                    // 看别人的帖子：显示关注，隐藏删除
                    btnDelete.style.display = 'none';
                    btnFollow.style.display = 'block';
                    btnEdit.style.display = 'none';
                    if (data.is_following) {
                        btnFollow.innerText = "已关注";
                        btnFollow.style.background = "#f0f0f0";
                        btnFollow.style.color = "#999";
                    } else {
                        btnFollow.innerText = "关注";
                        btnFollow.style.background = "var(--primary-red)";
                        btnFollow.style.color = "white";
                    }
                }

                document.getElementById('detail-image').src = `/asset/${data.user.username}/Posts/${data.post.ID}/${data.post.cover_image}`;
                document.getElementById('detail-avatar').src = `/asset/${data.user.username}/${data.user.avatar}`;
                document.getElementById('detail-username').innerText = data.user.username;
                document.querySelector('.detail-author').onclick = () => {
                    window.location.href = `/user/profile/${data.user.ID}`;
                };
                document.getElementById('detail-title').innerText = data.post.title;
                document.getElementById('detail-text').innerText = data.post.text;
                document.getElementById('count-like').innerText = data.like_count || 0;
                document.getElementById('count-collect').innerText = data.collect_count || 0;

                const btnLike = document.getElementById('btn-like');
                const iconLike = document.getElementById('icon-like');
                if (data.is_liked) {
                    btnLike.classList.add('liked');
                    iconLike.className = 'fas fa-heart';
                } else {
                    btnLike.classList.remove('liked');
                    iconLike.className = 'far fa-heart';
                }

                // 根据是否已收藏，切换 class
                const btnCollect = document.getElementById('btn-collect');
                const iconCollect = document.getElementById('icon-collect');
                if (data.is_collected) {
                    btnCollect.classList.add('collected');
                    iconCollect.className = 'fas fa-star';
                } else {
                    btnCollect.classList.remove('collected');
                    iconCollect.className = 'far fa-star';
                }

                // 格式化时间 (截取 YYYY-MM-DD)
                const dateStr = data.post.public_date ? data.post.public_date.split('T')[0] : "未知时间";
                document.getElementById('detail-time').innerText = dateStr;

                // === 替换开始：动态渲染楼中楼评论 ===
                const commentsList = document.getElementById('detail-comments-list');
                commentsList.innerHTML = "";
                const comments = data.comments || [];
                document.getElementById('comment-count-label').innerText = `共 ${comments.length} 条评论`;

                currentPostAuthorId = data.post.user_id; // 获取文章作者ID

                // 辅助函数：渲染单条评论的 HTML
                function renderCommentHTML(c, isSub, threadId) {
                    const dateStr = c.CreatedAt ? c.CreatedAt.split('T')[0] : "刚刚";
                    const avatarPath = `/asset/${c.user.username}/${c.user.avatar}`;
                    const likeIconClass = c.is_liked ? 'fas fa-heart' : 'far fa-heart';
                    const likeColor = c.is_liked ? 'color: var(--primary-red);' : 'color: #999;';

                    // 💡 如果是回复的回复，加上高亮的 @ 前缀
                    const safeUsername = escapeHtml(c.user.username);
                    let textHtml = escapeHtml(c.text);
                    if (isSub && c.reply_to) {
                        textHtml = `<span>回复 <span style="color: #5c7c9c;">@${escapeHtml(c.reply_to)}</span>: </span>${escapeHtml(c.text)}`;
                    }

                    // 判断是否是楼主（作者）
                    const authorTag = c.user_id === currentPostAuthorId ?
                        '<span style="background:#f0f0f0; color:#999; font-size:10px; padding:2px 6px; border-radius:10px; margin-left:6px;">作者</span>' : '';

                    // threadId 是顶级评论的 ID
                    const clickParentId = isSub ? threadId : c.ID;

                    return `
                        <div class="mock-comment" style="margin-bottom: ${isSub ? '15px' : '20px'};">
                            <img src="${avatarPath}" style="width: ${isSub ? '24px' : '32px'}; height: ${isSub ? '24px' : '32px'}; border-radius: 50%;" onerror="this.onerror=null; this.src='/static/avatar-placeholder.svg'">
                            <div class="mock-comment-content" style="flex: 1;">
                                <div class="name" style="color: #666; font-size: 13px; margin-bottom: 4px; display: flex; justify-content: space-between;">
                                    <span>${safeUsername}${authorTag}</span>
                                    <span style="color: #999; font-size: 12px;">${dateStr}</span>
                                </div>
                                <div class="text" style="color: #333; font-size: 14px; line-height: 1.5;">${textHtml}</div>

                                <div style="display: flex; align-items: center; gap: 20px; margin-top: 8px; font-size: 12px; color: #999;">
                                    <div style="cursor: pointer; display: flex; align-items: center; gap: 4px;" onclick="toggleCommentLike(${c.ID})">
                                        <i id="comment-like-icon-${c.ID}" class="${likeIconClass}" style="${likeColor} font-size: 13px; transition: transform 0.2s;"></i>
                                        <span id="comment-like-count-${c.ID}">${c.like_count || 0}</span>
                                    </div>
                                    <div style="cursor: pointer; font-weight: 500;" onclick="prepareReply(${clickParentId}, decodeURIComponent('${encodeURIComponent(c.user.username)}'), ${isSub})">回复</div>
                                </div>
                            </div>
                        </div>
                    `;
                }

                // 💡 分组算法：挑出所有一级评论
                const topComments = comments.filter(c => !c.parent_id || c.parent_id === 0);
                topComments.forEach(tc => {
                    let html = renderCommentHTML(tc, false, tc.ID);

                    // 挑出属于这个一级评论的所有子评论（楼中楼）
                    const subComments = comments.filter(c => c.parent_id === tc.ID);
                    if (subComments.length > 0) {
                        html += `<div style="margin-left: 42px; margin-bottom: 20px; padding: 10px 15px; background: #f9f9f9; border-radius: 8px;">`;
                        // 这里反转一下数组，让旧回复在上，新回复在下，更符合阅读习惯
                        subComments.reverse().forEach(sc => {
                            html += renderCommentHTML(sc, true, tc.ID);
                        });
                        html += `</div>`;
                    }
                    commentsList.innerHTML += html;
                });
                // === 替换结束 ===
            } else {
                alert("获取笔记详情失败");
                closePostDetail();
            }
        } catch (err) {
            console.error(err);
            alert("网络错误");
        }
    }

    function closePostDetail() {
        document.getElementById('post-detail-modal').style.display = 'none';
        setBodyLocked(false);
        const url = new URL(window.location.href);
        if (url.searchParams.has('note')) {
            url.searchParams.delete('note');
            history.replaceState(null, '', url);
        }
        // 清空内容，防止下次点开看到上一次残影
        document.getElementById('detail-image').src = "";
        document.getElementById('detail-title').innerText = "加载中...";
        document.getElementById('detail-text').innerText = "加载中...";
    }

    async function toggleLike() {
        if (!currentPostId) return;
        try {
            // 将发往你马上要写的后端接口
            const res = await fetch(`/api/posts/${currentPostId}/like`, {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ post_id: Number(currentPostId) })
            });

            if (res.ok) {
                const data = await res.json();
                // 动态更新UI
                const btnLike = document.getElementById('btn-like');
                const iconLike = document.getElementById('icon-like');
                document.getElementById('count-like').innerText = data.like_count;

                if (data.is_liked) {
                    btnLike.classList.add('liked');
                    iconLike.className = 'fas fa-heart';
                } else {
                    btnLike.classList.remove('liked');
                    iconLike.className = 'far fa-heart';
                }
            } else {
                openLoginModal();
            }
        } catch (err) { alert("网络请求错误"); }
    }

    // 收藏交互 (逻辑与点赞高度一致)
    async function toggleCollect() {
        if (!currentPostId) return;
        try {
            const res = await fetch(`/api/posts/${currentPostId}/collect`, {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ post_id: Number(currentPostId) })
            });

            if (res.ok) {
                const data = await res.json();
                const btnCollect = document.getElementById('btn-collect');
                const iconCollect = document.getElementById('icon-collect');
                document.getElementById('count-collect').innerText = data.collect_count;

                if (data.is_collected) {
                    btnCollect.classList.add('collected');
                    iconCollect.className = 'fas fa-star';
                } else {
                    btnCollect.classList.remove('collected');
                    iconCollect.className = 'far fa-star';
                }
            } else {
                openLoginModal();
            }
        } catch (err) { alert("网络请求错误"); }
    }

    window.prepareReply = function(parentId, targetName, isSub) {
        currentReplyParentId = parentId;
        // 如果回复的是二级评论，我们才加上 @ 他的名字
        currentReplyToName = isSub ? targetName : "";

        const input = document.getElementById('comment-input');
        input.placeholder = `回复 @${targetName} :`;
        input.focus();
    };

    // 💡 升级：提交评论时带上楼中楼关系
    async function submitComment() {
        if (!currentPostId) return;
        const input = document.getElementById('comment-input');
        const text = input.value.trim();

        if (!text) return showToast("评论内容不能为空");

        try {
            const res = await fetch(`/api/posts/${currentPostId}/comments`, {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({
                    post_id: Number(currentPostId),
                    text: text,
                    parent_id: currentReplyParentId,   // 传给后端：归属哪个大楼
                    reply_to: currentReplyToName       // 传给后端：@了谁
                })
            });

            if (res.ok) {
                input.value = "";
                input.placeholder = "说点什么..."; // 恢复默认占位符
                currentReplyParentId = 0;          // 清除回复状态
                currentReplyToName = "";

                openPostDetail(currentPostId);     // 刷新评论区
            } else {
                const data = await res.json();
                if (res.status === 401) openLoginModal();
                else showToast(data.error || "评论失败");
            }
        } catch (err) {
            alert("网络请求错误");
        }
    }

    async function toggleCommentLike(commentId) {
        try {
            // 发给你要写的后端新接口
            const res = await fetch(`/api/comments/${commentId}/like`, {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ comment_id: Number(commentId) })
            });

            if (res.ok) {
                const data = await res.json();

                // 获取对应评论的 DOM 元素进行局部刷新 (这样点赞不用重新加载整个列表)
                const icon = document.getElementById(`comment-like-icon-${commentId}`);
                const countSpan = document.getElementById(`comment-like-count-${commentId}`);

                countSpan.innerText = data.like_count;
                if (data.is_liked) {
                    icon.className = 'fas fa-heart';
                    icon.style.color = 'var(--primary-red)';
                } else {
                    icon.className = 'far fa-heart';
                    icon.style.color = '#999';
                }
            } else {
                openLoginModal();
            }
        } catch (err) {
            alert("网络请求错误");
        }
    }

    async function toggleModalFollow() {
        if (!currentPostAuthorId) return;
        await sendFollowRequest(currentPostAuthorId, 'modal');
    }

    // 💡 处理个人主页大按钮的关注点击
    async function toggleProfileFollow(targetId) {
        await sendFollowRequest(targetId, 'profile');
    }

    // 统一发送关注请求的函数
    async function sendFollowRequest(targetId, source) {
        try {
            const res = await fetch(`/api/users/${targetId}/follow`, {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ target_id: Number(targetId) })
            });

            if (res.ok) {
                const data = await res.json();

                // 如果是在详情弹窗里点的
                if (source === 'modal') {
                    const btn = document.getElementById('modal-btn-follow');
                    if (data.is_following) {
                        btn.innerText = "已关注";
                        btn.style.background = "#f0f0f0";
                        btn.style.color = "#999";
                    } else {
                        btn.innerText = "关注";
                        btn.style.background = "var(--primary-red)";
                        btn.style.color = "white";
                    }
                }
                // 如果是在个人主页点的
                else if (source === 'profile') {
                    // 刷新当前页面让各种统计数字重新计算
                    window.location.reload();
                }
            } else {
                openLoginModal();
            }
        } catch (err) { alert("网络错误"); }
    }

    let ws;
    let unreadCount = 0;
    const currentUserId = '{{.LoggedInUserID}}';

    // 页面加载完成后，立刻拉取一次历史消息，算一下有几个未读
    if (currentUserId !== "") {
        loadHistoricalNotifications();
        initWebSocket();
    }

    // 初始化 WebSocket
    function initWebSocket() {
        ws = new WebSocket((window.location.protocol === 'https:' ? 'wss://' : 'ws://') + window.location.host + "/api/ws");
        ws.onopen = function() { console.log("🟢 WebSocket 基站连接成功！"); };
        ws.onclose = function() { console.log("🔴 WebSocket 连接已断开"); };

        ws.onmessage = function(event) {
            const data = JSON.parse(event.data);
            // 收到后端推送后，红点数字 +1，并重新拉取列表刷新弹窗
            unreadCount++;
            updateBadgeUI();
            loadHistoricalNotifications();
        };
    }

    // 更新红点 UI
    function updateBadgeUI() {
        const badge = document.getElementById('unread-badge');
        if (unreadCount > 0) {
            badge.innerText = unreadCount > 99 ? '99+' : unreadCount;
            badge.style.display = 'inline-block';
        } else {
            badge.style.display = 'none';
        }
    }

    // 从后端 API 拉取所有通知
    async function loadHistoricalNotifications() {
        try {
            const res = await fetch('/api/notifications');
            if (res.ok) {
                const data = await res.json();
                const notifs = data.notifications || [];

                // 计算未读数量
                unreadCount = notifs.filter(n => !n.is_read).length;
                updateBadgeUI();

                // 渲染到弹窗的列表里
                renderNotificationList(notifs);
            }
        } catch (e) { console.error("通知拉取失败", e); }
    }

    // 渲染通知列表 HTML
    function renderNotificationList(notifs) {
        const container = document.getElementById('notification-list-container');
        if (notifs.length === 0) {
            container.innerHTML = '<div style="text-align:center; padding: 40px; color:#999;">暂无新通知哦</div>';
            return;
        }

        let html = '';
        notifs.forEach(n => {
            // 根据类型动态生成文案
            let actionText = "给你发了消息";
            if (n.type === "like_post") actionText = "赞了你的笔记";
            else if (n.type === "like_comment") actionText = "赞了你的评论";
            else if (n.type === "collect_post") actionText = "收藏了你的笔记";
            else if (n.type === "comment") actionText = `评论了你：${escapeHtml(n.content || '')}`;
            else if (n.type === "follow") actionText = "关注了你";

            const username = escapeHtml(n.from_user?.username || '小红薯');
            const avatar = n.from_user ? `/asset/${encodeURIComponent(n.from_user.username)}/${encodeURIComponent(n.from_user.avatar)}` : '';

            html += `
            <div class="notification-item ${n.is_read ? '' : 'unread'}">
                <img src="${avatar}"
                     style="width: 40px; height: 40px; border-radius: 50%; object-fit: cover; margin-right: 12px;"
                     onerror="this.onerror=null;this.src='/static/avatar-placeholder.svg'">
                <div style="flex: 1;">
                    <div style="font-size: 14px; color: #333;"><span style="font-weight:bold;">${username}</span> ${actionText}</div>
                    <div style="font-size: 12px; color: #999; margin-top: 4px;">${n.CreatedAt ? n.CreatedAt.split('T')[0] : '刚刚'}</div>
                </div>
            </div>`;
        });
        container.innerHTML = html;
    }

    // 打开通知面板并标记为已读
    async function openNotificationModal(e) {
        if (e) e.preventDefault();

        // 如果没登录，弹登录框
        if (currentUserId === "") {
            openLoginModal();
            return;
        }

        document.getElementById('notification-modal').style.display = 'flex';
        setBodyLocked(true);

        // 如果有未读消息，向后端发送请求清空，并把前端红点归零
        if (unreadCount > 0) {
            unreadCount = 0;
            updateBadgeUI();
            await fetch('/api/notifications/read', { method: 'POST' });
            // 重新拉取一次，把底色变白
            loadHistoricalNotifications();
        }
    }

    // 关闭通知面板
    function closeNotificationModal() {
        document.getElementById('notification-modal').style.display = 'none';
        setBodyLocked(false);
    }

    async function deletePost() {
        if (!currentPostId) return;

        // 增加二次确认防误触
        if (!confirm("确定要删除这篇笔记吗？删除后将无法恢复！")) {
            return;
        }

        try {
            const res = await fetch(`/api/posts/${currentPostId}`, {
                method: 'DELETE'
            });

            if (res.ok) {
                alert("删除成功！");
                window.location.reload(); // 简单粗暴，直接刷新页面让被删的帖子消失
            } else {
                const data = await res.json();
                alert(data.error || "删除失败");
            }
        } catch (err) {
            alert("网络请求错误");
        }
    }

    function openEditPostModal() {
        document.getElementById('edit-post-title').value = document.getElementById('detail-title').innerText;
        document.getElementById('edit-post-text').value = document.getElementById('detail-text').innerText;
        document.getElementById('edit-post-cover-preview').src = document.getElementById('detail-image').src;

        // 💡 新增：回显可见性
        document.getElementById('edit-post-visible').value = currentPostVisible ? "true" : "false";

        document.getElementById('edit-post-cover').value = "";
        document.getElementById('edit-post-modal').style.display = 'flex';
    }

    // 2. 关闭编辑弹窗
    function closeEditPostModal() {
        document.getElementById('edit-post-modal').style.display = 'none';
    }

    // 3. 预览新选的封面图
    function previewEditPostCover(event) {
        const file = event.target.files[0];
        if (file) {
            document.getElementById('edit-post-cover-preview').src = URL.createObjectURL(file);
        }
    }

    // 4. 发送 PUT 请求到后端
    // 提交编辑时，把可见性状态追加进去
    async function submitEditPost() {
        if (!currentPostId) return;

        const title = document.getElementById('edit-post-title').value;
        const text = document.getElementById('edit-post-text').value;
        const visible = document.getElementById('edit-post-visible').value; // 💡 新增
        const coverFile = document.getElementById('edit-post-cover').files[0];

        if (!title.trim()) return alert("标题不能为空！");

        const formData = new FormData();
        formData.append("title", title);
        formData.append("text", text);
        formData.append("visible", visible); // 💡 发送给后端
        if (coverFile) {
            formData.append("cover", coverFile);
        }

        try {
            const res = await fetch(`/api/posts/${currentPostId}`, {
                method: 'PUT',
                body: formData
            });

            if (res.ok) {
                alert("修改成功！");
                window.location.reload();
            } else {
                const data = await res.json();
                alert(data.error || "修改失败");
            }
        } catch (err) {
            alert("网络错误");
        }
    }

    document.getElementById('feed-search')?.addEventListener('input', event => applyFeedFilter(event.target.value));
    document.querySelectorAll('.cat-item').forEach(item => {
        item.addEventListener('click', () => {
            document.querySelectorAll('.cat-item').forEach(tab => tab.classList.remove('active'));
            item.classList.add('active');
            const input = document.getElementById('feed-search');
            if (item.textContent.trim() === '推荐') {
                input.value = '';
                applyFeedFilter('');
            } else {
                input.value = item.textContent.trim();
                applyFeedFilter(input.value);
            }
        });
    });

    document.getElementById('comment-input')?.addEventListener('keydown', event => {
        if (event.key === 'Enter' && !event.shiftKey) {
            event.preventDefault();
            submitComment();
        }
    });
    ['login-username', 'login-password'].forEach(id => document.getElementById(id)?.addEventListener('keydown', event => {
        if (event.key === 'Enter') handleLogin();
    }));
    ['reg-username', 'reg-password'].forEach(id => document.getElementById(id)?.addEventListener('keydown', event => {
        if (event.key === 'Enter') handleRegister();
    }));

    document.addEventListener('keydown', event => {
        if (event.key !== 'Escape') return;
        if (document.getElementById('edit-post-modal').style.display === 'flex') closeEditPostModal();
        else if (document.getElementById('post-detail-modal').style.display === 'flex') closePostDetail();
        else if (document.getElementById('notification-modal').style.display === 'flex') closeNotificationModal();
        else if (document.getElementById('login-modal').style.display === 'flex') closeModal();
    });

    const initialPostId = new URL(window.location.href).searchParams.get('note');
    if (initialPostId) openPostDetail(initialPostId);
    const initialAction = new URL(window.location.href).searchParams;
    if (initialAction.get('login') === '1') openLoginModal();
    if (initialAction.get('notifications') === '1') openNotificationModal();
</script>

</body>
</html>
